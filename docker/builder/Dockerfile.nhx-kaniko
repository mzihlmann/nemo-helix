#
# The sandbox's kaniko image: the osscontainertools fork's `debug` image
# (github.com/osscontainertools/kaniko), pinned by digest and republished, so a release runs its own
# copy. It has the layout `supervise` relies on: /kaniko/executor, and a shell at /busybox/sh. kaniko
# replaces the root filesystem as it builds, except /kaniko and volumes, so busybox is a volume. Its
# credential helpers stay unused: `supervise` turns them off, and the sandbox holds no credential.

ARG KANIKO_VERSION=v1.29.0
ARG NHX_PYTHON_BASE=nhx-python-base

FROM ghcr.io/osscontainertools/kaniko:${KANIKO_VERSION}-debug@sha256:350929376b8a69afb1d8b362086c809e4ef6799fa1bcb317c2806ae1447b3845 AS kaniko

# The image has no Python, so its sources are collected here, for the components its Go binaries
# don't record. The SPDX documents in /kaniko/sbom pin BusyBox and the Alpine 3.23 musl it links
# statically, and tini with the Ubuntu xenial glibc it links statically, for the image's platform.
# docker/sources/nhx-kaniko.json pins the rest: kaniko itself, the patches and build script Docker
# builds BusyBox with, and Alpine's musl patches. Debian trixie's ca-certificates, from which the CA
# bundle is generated, come from apt. Re-check the manifest whenever the digest above moves.
FROM ${NHX_PYTHON_BASE} AS sources
ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
COPY docker/sources/nhx-kaniko.json /tmp/nhx-kaniko.json
COPY --from=kaniko /kaniko/sbom/ /tmp/kaniko-sbom/
COPY --from=kaniko /kaniko/executor /kaniko/warmer /kaniko/docker-credential-gcr \
    /kaniko/docker-credential-ecr-login /kaniko/docker-credential-acr-env /tmp/kaniko/
RUN python3 /usr/local/bin/collect-pinned-sources.py \
        --manifest /tmp/nhx-kaniko.json \
        --spdx /tmp/kaniko-sbom/busybox.spdx.json \
        --spdx /tmp/kaniko-sbom/tini.spdx.json \
        --skip-spdx-package docker-library-busybox \
        --output /source-distributions/nhx-kaniko && \
    bash /usr/local/bin/collect-apt-sources.sh /source-distributions/nhx-kaniko/apt ca-certificates && \
    python3 /usr/local/bin/collect-go-module-sources.py \
        --binary /tmp/kaniko/executor \
        --binary /tmp/kaniko/warmer \
        --binary /tmp/kaniko/docker-credential-gcr \
        --binary /tmp/kaniko/docker-credential-ecr-login \
        --binary /tmp/kaniko/docker-credential-acr-env \
        --output /source-distributions/nhx-kaniko

# Under /kaniko, unlike other images: kaniko builds in its own root filesystem and never snapshots
# /kaniko, so a build's RUN steps can't change the sources or copy them into the image they build.
FROM kaniko AS runtime
COPY --from=sources /etc/ssl/certs/ca-certificates.crt /kaniko/ssl/certs/ca-certificates.crt
COPY --from=sources /source-distributions/nhx-kaniko/ /kaniko/source-distributions/nhx-kaniko/

# The binary runs on the image's platform, and `supervise`'s shell, /busybox/sh, is there.
FROM runtime AS smoke-test
ARG KANIKO_VERSION
RUN ["/bin/sh", "-c", "/kaniko/executor version | grep -qF \"$KANIKO_VERSION\" && test -x /busybox/sh"]

FROM runtime
